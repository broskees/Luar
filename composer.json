{
    "name": "broskees/luar",
    "description": "Lua interpreter written entirely in PHP (PHP 8.4 fork)",
    "type": "library",
    "version": "0.1.5",
    "require": {
        "php": "^8.0",
        "antlr/antlr4-php-runtime": "^0.9.1",
        "ext-json": "*"
    },
    "license": "GPL-2.0-only",
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "clean/phpdoc-md": "^0.19.3"
    },
    "authors": [
        {
            "name": "Raul Ferreira Fuentes",
            "email": "r.ferreira.fuentes@gmail.com"
        },
        {
            "name": "Joseph Roberts",
            "email": "joseph@digitaljoe.co"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raudius\\Luar\\": "src",
            "Raudius\\Luar\\UnitTests\\": "tests/unit"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c tests/phpunit.xml",
        "docs:generate": "phpdoc-md",
        "parser:generate": "bash scripts/regenerate-parser.sh"
    }
}
